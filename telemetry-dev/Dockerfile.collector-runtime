FROM golang:1.24-alpine AS builder
WORKDIR /src
# Some public modules return 403 from the primary proxy in restricted networks.
# Fall back to goproxy.io for those failures; Go still checks module hashes.
ENV GOPROXY=https://proxy.golang.org|https://goproxy.io
RUN go install go.opentelemetry.io/collector/cmd/builder@v0.136.0
COPY collector-builder.yaml ./collector-builder.yaml
COPY p95policyprocessor ./p95policyprocessor
RUN /go/bin/builder --config=collector-builder.yaml

FROM alpine:3.22
RUN addgroup -S otel && adduser -S -G otel -u 10001 otel
COPY --from=builder /build/devassistant-otelcol /usr/local/bin/devassistant-otelcol
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/devassistant-otelcol"]
