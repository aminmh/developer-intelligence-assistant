# MinIO/S3 credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password

# Signs/verifies RAG upload-session JWTs (Python/python-api). Must be at least
# 32 bytes (256 bits) for HS256.
UPLOAD_TOKEN_SECRET=change-me-to-a-random-32-byte-secret

# TUSD hook secret (shared secret between tusd and Python API for the ZIP
# post-finish hook path; unused by the RAG upload path, which authenticates
# via UPLOAD_TOKEN_SECRET instead since tusd cannot sign hook deliveries)
TUSD_HOOK_SECRET=change-me-to-another-random-secret

# Shared secret used by Python service for /download-jobs internal auth.
# Must match RAG_CALLBACK_SECRET in web/.env.
RAG_CALLBACK_SECRET=change-me-to-a-random-secret

# Signs/verifies download-result JWTs (Python/python-api). Used for the
# /download-jobs → /download/{token} pipeline.
DOWNLOAD_TOKEN_SECRET=change-me-to-another-random-32-byte-secret

OLLAMA_EMBED_MODEL=BGE-M3
# Idle time before local chat and embedding models are unloaded from RAM. Use
# Ollama duration syntax (for example 30s, 5m, 1h); 0 unloads immediately.
OLLAMA_KEEP_ALIVE=5m
LSP_WARMUP_ENABLED=false

# Optional remote gVisor sandbox. Point this at the local SSH directory that
# contains the alias, key and known_hosts (mounted read-only into python-api).
# The value is intentionally not stored by the web application.
SANDBOX_SSH_DIR=/absolute/path/to/your/.ssh

# Neo4j property-graph backend (LlamaIndex hybrid retrieval). Defaults match
# the docker-compose neo4j service auth below.
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Optional local runtime telemetry profile (`docker compose --profile runtime up -d`).
# Replace the local-only password before using this stack beyond development.
TELEMETRY_CLICKHOUSE_URL=http://telemetry-clickhouse:8123
TELEMETRY_CLICKHOUSE_USER=telemetry
TELEMETRY_CLICKHOUSE_PASSWORD=replace-with-a-strong-random-secret
TELEMETRY_CLICKHOUSE_DATABASE=telemetry
TELEMETRY_CLICKHOUSE_TABLE=otel_traces
TELEMETRY_RETENTION_HOURS=72
TELEMETRY_AGGREGATION_RETENTION_HOURS=72
TELEMETRY_RECORDING_PERCENT=100
TELEMETRY_OTLP_ENDPOINT=http://host.docker.internal:24318

# Optional CI source uploads: map project slugs to unique high-entropy bearer
# tokens (32+ characters). Keep real tokens in a secret manager, not this file.
TELEMETRY_CI_PROJECT_TOKENS={}

# Optional per-host Docker deployment reporting. Scope keys are lowercase,
# colon-free SHA-256 client-certificate fingerprints; use least-privilege scopes.
TELEMETRY_HOST_SCOPES={}
TELEMETRY_INGRESS_BIND=127.0.0.1
TELEMETRY_INGRESS_PORT=9443
# TELEMETRY_INGRESS_CERT_DIR=/absolute/path/to/managed/ingress-certs
