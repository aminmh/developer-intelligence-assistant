# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: API endpoint for the backend service.
# Set to http://localhost:8000 if you have a Docker backend running on that port.
# Leave empty to use relative URLs (same origin).
VITE_API_URL="http://localhost:8000"

# VITE_UPLOAD_API_URL: python-api base URL, used by the browser to create resumable
# TUS upload sessions for large files. Host-published dev port of the api/ stack.
VITE_UPLOAD_API_URL="http://localhost:9002"

# VITE_TUS_THRESHOLD_BYTES: files at or above this size use the resumable TUS upload
# path instead of the inline base64/JSON POST. Default 10MB.
VITE_TUS_THRESHOLD_BYTES="10485760"

# RAG_CALLBACK_SECRET: shared secret authenticating python-api's server-to-server
# callback (POST /api/internal/rag-index) once it has extracted text from a large
# upload. Must match RAG_CALLBACK_SECRET in api/.env.
RAG_CALLBACK_SECRET="change-me-to-a-random-secret"
