# MinIO/S3 credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password

# Signs/verifies RAG upload-session JWTs (PHP/php-ast) and ZIP upload-session
# JWTs (Python/python-api). Must be at least 32 bytes (256 bits) -- PHP's JWT
# library enforces this minimum for HS256 and will reject shorter secrets.
UPLOAD_TOKEN_SECRET=change-me-to-a-random-32-byte-secret

# TUSD hook secret (shared secret between tusd and Python API for the ZIP/AST
# post-finish hook path; unused by the RAG document path, which authenticates
# via UPLOAD_TOKEN_SECRET instead since tusd cannot sign hook deliveries)
TUSD_HOOK_SECRET=change-me-to-another-random-secret

# Shared secret authenticating php-ast's callback into web's Node server
# (POST /api/internal/rag-index) once a large RAG document has been extracted.
# Must match RAG_CALLBACK_SECRET in web/.env.
# Also used by Python service for /download-jobs internal auth.
RAG_CALLBACK_SECRET=change-me-to-a-random-secret

# Signs/verifies download-result JWTs (Python/python-api). Used for the
# /download-jobs → /download/{token} pipeline.
DOWNLOAD_TOKEN_SECRET=change-me-to-another-random-32-byte-secret

# Set to true in development so Swagger docs regenerate on each page visit.
# Set to false in production.
L5_SWAGGER_GENERATE_ALWAYS=true
