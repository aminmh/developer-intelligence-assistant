# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: API endpoint for the backend service.
# This app serves its own API from the same Express process/port as the
# frontend (see server.ts) -- leave empty so requests use relative URLs
# (same origin). Only set this if the API is genuinely on a different origin.
VITE_API_URL=""

# VITE_UPLOAD_API_URL: php-ast base URL, used by the browser to create resumable
# TUS upload sessions for large files. Host-published dev port of the api/ stack.
VITE_UPLOAD_API_URL="http://localhost:9003"

# VITE_TUS_THRESHOLD_BYTES: files at or above this size use the resumable TUS upload
# path instead of the inline base64/JSON POST. Default 10MB.
VITE_TUS_THRESHOLD_BYTES="10485760"

# RAG_CALLBACK_SECRET: shared secret authenticating php-ast's server-to-server
# callback (POST /api/internal/rag-index) once it has extracted text from a large
# upload. Must match RAG_CALLBACK_SECRET in api/.env.
RAG_CALLBACK_SECRET="change-me-to-a-random-secret"

# PHP_SERVICE_URL: base URL of the PHP/php-ast service for aggregating uploaded
# file lists. npm run dev on host uses http://127.0.0.1:9003; Docker overrides
# this to http://php-ast:9003 via docker-compose.yml environment.
PHP_SERVICE_URL="http://php-ast:9003"

# OLLAMA_URL: URL of the Ollama embedding service. npm run dev on host uses
# http://localhost:11434; Docker overrides to http://host.docker.internal:11434.
OLLAMA_URL="http://localhost:11434"

# PYTHON_API_URL: URL of the Python code-intelligence service. npm run dev
# on host uses http://localhost:9002; Docker overrides to http://python-api:9002.
PYTHON_API_URL="http://python-api:9002"
OLLAMA_MODEL="BGE-M3"
# Optional default RAGAS evaluation judge model. The UI setting takes precedence.
OLLAMA_EVAL_MODEL="gemma3-4b"

# GGUF import directory. The web container mounts this directory read-only at
# /ollama-imports and uploads selected files to Ollama through its HTTP API.
OLLAMA_IMPORT_HOST_ROOT="/Volumes/Projects/Projects/Developer Assistant/web/ollama-imports"

# Local OIDC development with the Keycloak service in docker-compose.yml.
# Keep issuer browser-visible. Use localhost for host-run npm dev; Compose
# overrides OIDC_INTERNAL_ISSUER with the Keycloak service address.
OIDC_ISSUER="http://localhost:8180/realms/developer-assistant"
OIDC_INTERNAL_ISSUER="http://localhost:8180/realms/developer-assistant"
# Optional for `just up-lite`: provider URL reachable from the Web container.
# Defaults to OIDC_ISSUER when blank.
OIDC_LITE_INTERNAL_ISSUER=""
OIDC_CLIENT_ID="developer-assistant-web"
OIDC_CLIENT_SECRET="generate-a-random-client-secret"
OIDC_REDIRECT_URI="http://localhost:3000/api/auth/callback"
OIDC_BOOTSTRAP_ADMIN_SUB="3ca3f484-5ef2-4c37-a8e8-d55d0cf47fb8"
SESSION_SECRET="generate-at-least-32-random-characters"
SESSION_TTL_MS="28800000"
SESSION_COOKIE_SECURE="false"
AUTH_STORE_PATH="data/auth-store.json"
WEB_ORIGIN="http://localhost:3000"
KEYCLOAK_ADMIN_USERNAME="admin"
KEYCLOAK_ADMIN_PASSWORD="generate-a-random-keycloak-console-password"
KEYCLOAK_BOOTSTRAP_PASSWORD="generate-a-random-app-user-password"

# Optional local Outline profile (`just outline-up`). The command generates
# missing values and stores them in the ignored web/.env file. Keep these local.
OUTLINE_SECRET_KEY=""
OUTLINE_UTILS_SECRET=""
OUTLINE_DATABASE_PASSWORD=""
OUTLINE_OIDC_CLIENT_SECRET=""
