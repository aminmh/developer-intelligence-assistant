# syntax=docker/dockerfile:1.7
FROM golang:1.24-alpine AS builder
WORKDIR /src
# Some public modules return 403 from the primary proxy in restricted networks.
# Fall back to goproxy.io for those failures; Go still checks module hashes.
ENV GOPROXY=https://proxy.golang.org|https://goproxy.io
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build go install go.opentelemetry.io/collector/cmd/builder@v0.136.0
COPY collector-builder.yaml ./collector-builder.yaml
COPY p95policyprocessor ./p95policyprocessor
COPY clickhouse-router ./clickhouse-router
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build /go/bin/builder --config=collector-builder.yaml
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GO111MODULE=off go build -trimpath -o /build/clickhouse-router ./clickhouse-router

FROM alpine:3.22
RUN addgroup -S -g 10001 otel && adduser -S -G otel -u 10001 otel
COPY --from=builder /build/devassistant-otelcol /usr/local/bin/devassistant-otelcol
COPY --from=builder /build/clickhouse-router /usr/local/bin/clickhouse-router
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/devassistant-otelcol"]
