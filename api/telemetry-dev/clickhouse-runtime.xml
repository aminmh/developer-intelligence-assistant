<clickhouse>
    <!-- Keep background compaction from saturating the local development VM. -->
    <background_pool_size>4</background_pool_size>
    <background_merges_mutations_concurrency_ratio>1</background_merges_mutations_concurrency_ratio>
    <merge_tree>
        <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>2</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>

    <!-- Bound ClickHouse's own diagnostic tables by age. TTL cleanup is asynchronous. -->
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <trace_log>
        <ttl>event_date + INTERVAL 48 HOUR DELETE</ttl>
    </trace_log>
    <text_log>
        <level>warning</level>
        <ttl>event_date + INTERVAL 72 HOUR DELETE</ttl>
    </text_log>
    <!-- Metric logs are very wide tables written every few seconds; on the local VM their merges
         alone exceeded max_server_memory_usage and blocked telemetry inserts and queries.
         Nothing in Developer Assistant reads them, so they are disabled. -->
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
</clickhouse>
